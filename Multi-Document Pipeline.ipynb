    "## 7. PageRank + Temporal + Burst + Lifecycle + Score"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "scoring-cell",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "2026-04-25 12:14:16 [INFO] audit_pipeline: Scoring layer defined.\n"
